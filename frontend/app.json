{
  "expo": {
    "name": "Manu's Resto Manager",
    "slug": "manus-resto-manager",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "manusresto",
    "icon": "./public/bglogo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1E3A2B",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./public/nobglogo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0B3827"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Manu's Resto Manager to scan product barcodes."
        }
      ],
      "./plugins/withGooglePlayStoreQuery",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Manu's Resto Manager to use device biometrics to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Manu's Resto Manager to access photos so you can add product images."
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "android": {
      "package": "com.manusresto.manager",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./public/nobglogo.png",
        "backgroundColor": "#0B3827"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.manusresto.manager"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1b7e4ecd-076d-4ec9-876a-dfecba71c2f6"
      }
    }
  }
}