{
  "expo": {
    "name": "Manu's Resto Manager",
    "slug": "manus-resto-manager",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "manusresto",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1E3A2B",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Manu's Resto Manager to scan product barcodes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Manu's Resto Manager to use device biometrics to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Manu's Resto Manager to access photos so you can add product images."
        }
      ],
      "expo-sharing"
    ],
    "android": {
      "package": "com.manusresto.manager"
    },
    "ios": {
      "bundleIdentifier": "com.manusresto.manager"
    }
  }
}
